generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core taxonomy
// ---------------------------------------------------------------------------

model Manufacturer {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  foundedYear Int?
  country     String?
  colorHex    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brands   Brand[]
  products Product[]

  @@index([name])
}

model Brand {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  manufacturerId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  products     Product[]

  @@index([manufacturerId])
}

model Country {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())

  leagues       League[]
  clubs         Club[]
  nationalTeams NationalTeam[]
  players       Player[]       @relation("PlayerNationality")
}

model League {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  countryId String?
  createdAt DateTime @default(now())

  country  Country?  @relation(fields: [countryId], references: [id])
  clubs    Club[]
  products Product[]

  @@index([countryId])
}

model Club {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  leagueId  String?
  countryId String?
  createdAt DateTime @default(now())

  league  League?  @relation(fields: [leagueId], references: [id])
  country Country? @relation(fields: [countryId], references: [id])
  players Player[]

  @@index([leagueId])
  @@index([countryId])
  @@index([name])
}

model NationalTeam {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  countryId      String
  confederation  String?
  createdAt      DateTime @default(now())

  country Country  @relation(fields: [countryId], references: [id])
  players Player[]

  @@index([countryId])
  @@index([name])
}

enum TournamentType {
  FIFA_WORLD_CUP
  FIFA_WOMENS_WORLD_CUP
  UEFA_EURO
  COPA_AMERICA
  UEFA_CHAMPIONS_LEAGUE
  UEFA_EUROPA_LEAGUE
  UEFA_CONFERENCE_LEAGUE
  FIFA_CLUB_WORLD_CUP
  OLYMPIC_FOOTBALL
  DOMESTIC_LEAGUE
  OTHER
}

model Tournament {
  id        String         @id @default(cuid())
  slug      String         @unique
  name      String
  type      TournamentType
  createdAt DateTime       @default(now())

  products Product[]

  @@index([type])
}

enum Position {
  GK
  DEF
  MID
  FWD
}

enum PlayerEra {
  LEGEND
  MODERN
  CURRENT
  ROOKIE
  PROSPECT
}

model Player {
  id             String    @id @default(cuid())
  slug           String    @unique
  fullName       String
  firstName      String?
  lastName       String?
  nationalityId  String?
  nationalTeamId String?
  clubId         String?
  position       Position
  era            PlayerEra @default(CURRENT)
  birthYear      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  nationality    Country?            @relation("PlayerNationality", fields: [nationalityId], references: [id])
  nationalTeam   NationalTeam?       @relation(fields: [nationalTeamId], references: [id])
  club           Club?               @relation(fields: [clubId], references: [id])
  checklistEntries ChecklistEntry[]

  @@index([fullName])
  @@index([clubId])
  @@index([nationalTeamId])
  @@index([era])
  @@index([position])
}

// ---------------------------------------------------------------------------
// Products, sets, checklists, cards
// ---------------------------------------------------------------------------

enum ProductFormat {
  HOBBY_BOX
  BLASTER
  RETAIL_BOX
  MEGA_BOX
  HANGER
  FAT_PACK
  ALBUM
  STARTER_PACK
  SPECIAL_EDITION
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  manufacturerId String
  brandId        String?
  year           Int
  season         String?
  releaseYear    Int
  tournamentId   String?
  leagueId       String?
  format         ProductFormat
  description    String        @db.Text
  accentHex      String?
  featured       Boolean       @default(false)
  packsPerBox    Int
  cardsPerPack   Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id])
  brand        Brand?       @relation(fields: [brandId], references: [id])
  tournament   Tournament?  @relation(fields: [tournamentId], references: [id])
  league       League?      @relation(fields: [leagueId], references: [id])

  sets      CardSet[]
  parallels Parallel[]
  oddsRules PackOddsRule[]
  packs     Pack[]
  boxes     Box[]
  userCards UserCard[]

  @@index([manufacturerId, year])
  @@index([tournamentId])
  @@index([leagueId])
  @@index([featured])
  @@index([releaseYear])
  @@index([name])
}

enum SetType {
  BASE
  INSERT
  PARALLEL_SET
  SP
  SSP
  CASE_HIT
  IMAGE_VARIATION
  AUTOGRAPH
  RELIC
  BOOKLET
  PRINTING_PLATE
  OTHER
}

model CardSet {
  id        String  @id @default(cuid())
  productId String
  slug      String
  name      String
  setType   SetType @default(BASE)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  checklistEntries ChecklistEntry[]
  parallels        Parallel[]
  oddsRules        PackOddsRule[]

  @@unique([productId, slug])
  @@index([productId, setType])
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  ULTRA_RARE
  MYTHIC
  LEGENDARY
}

enum CardType {
  BASE
  INSERT
  PARALLEL
  REFRACTOR
  SP
  SSP
  CASE_HIT
  IMAGE_VARIATION
  AUTOGRAPH
  DUAL_AUTOGRAPH
  TRIPLE_AUTOGRAPH
  QUAD_AUTOGRAPH
  PATCH
  JUMBO_PATCH
  RELIC
  MEMORABILIA
  BOOKLET
  PRINTING_PLATE
  ONE_OF_ONE
  SHIELD_PATCH
  LOGO_PATCH
  LAUNDRY_TAG
  CLEAT_RELIC
}

model Parallel {
  id         String   @id @default(cuid())
  productId  String?
  cardSetId  String?
  slug       String
  name       String
  printRun   Int?
  colorHex   String?
  isFoil     Boolean  @default(false)
  rarity     Rarity   @default(COMMON)
  cardType   CardType @default(PARALLEL)
  weight     Float    @default(1)
  createdAt  DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  cardSet CardSet? @relation(fields: [cardSetId], references: [id], onDelete: Cascade)
  cards   Card[]

  @@index([productId])
  @@index([cardSetId])
  @@index([slug])
}

model ChecklistEntry {
  id         String   @id @default(cuid())
  cardSetId  String
  playerId   String
  cardNumber String
  sortOrder  Int      @default(0)
  notes      String?
  createdAt  DateTime @default(now())

  cardSet     CardSet           @relation(fields: [cardSetId], references: [id], onDelete: Cascade)
  player      Player            @relation(fields: [playerId], references: [id])
  cards       Card[]
  autograph   AutographSpec?
  memorabilia MemorabiliaSpec?

  @@unique([cardSetId, cardNumber])
  @@index([playerId])
  @@index([cardSetId, sortOrder])
}

/// Unique collectible SKU = checklist entry × parallel. Designed for 1M+ rows.
/// `estimatedValueCents` is the UI source of truth for market value; computed by
/// `src/lib/market-value.ts` at seed/reprice (swap that module for live comps later).
model Card {
  id                  String   @id @default(cuid())
  checklistEntryId    String
  parallelId          String
  slug                String   @unique
  estimatedValueCents Int      @default(0)
  frontImageUrl       String?
  backImageUrl        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  checklistEntry ChecklistEntry  @relation(fields: [checklistEntryId], references: [id], onDelete: Cascade)
  parallel       Parallel        @relation(fields: [parallelId], references: [id], onDelete: Cascade)
  numbering      NumberingSpec?
  userCards      UserCard[]
  wishlistItems  WishlistItem[]
  favorites      Favorite[]

  @@unique([checklistEntryId, parallelId])
  @@index([estimatedValueCents])
  @@index([parallelId])
  @@index([checklistEntryId])
}

model NumberingSpec {
  id       String @id @default(cuid())
  cardId   String @unique
  printRun Int

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model AutographSpec {
  id               String  @id @default(cuid())
  checklistEntryId String  @unique
  signerCount      Int     @default(1)
  onCard           Boolean @default(true)

  checklistEntry ChecklistEntry @relation(fields: [checklistEntryId], references: [id], onDelete: Cascade)
}

enum MemorabiliaType {
  PATCH
  JUMBO_PATCH
  RELIC
  MEMORABILIA
  SHIELD_PATCH
  LOGO_PATCH
  LAUNDRY_TAG
  CLEAT_RELIC
  BOOKLET
  PRINTING_PLATE
}

model MemorabiliaSpec {
  id               String          @id @default(cuid())
  checklistEntryId String          @unique
  memorabiliaType  MemorabiliaType
  isMultiColor     Boolean         @default(false)

  checklistEntry ChecklistEntry @relation(fields: [checklistEntryId], references: [id], onDelete: Cascade)
}

enum OddsScope {
  PER_PACK
  PER_BOX
  PER_CASE
}

model PackOddsRule {
  id            String    @id @default(cuid())
  productId     String
  cardSetId     String?
  parallelId    String?
  label         String
  scope         OddsScope @default(PER_PACK)
  expectedCount Float
  createdAt     DateTime  @default(now())

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cardSet CardSet? @relation(fields: [cardSetId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([cardSetId])
}

model Pack {
  id        String  @id @default(cuid())
  productId String
  label     String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Box {
  id         String @id @default(cuid())
  productId  String
  label      String
  packsCount Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Users & collections
// ---------------------------------------------------------------------------

model User {
  id          String   @id @default(cuid())
  email       String?  @unique
  displayName String   @default("Collector")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cards     UserCard[]
  wishlist  WishlistItem[]
  favorites Favorite[]
  binders   Binder[]
  showcase  ShowcaseItem[]
}

model UserCard {
  id            String   @id @default(cuid())
  userId        String
  cardId        String
  productId     String
  serialNumber  Int?
  serialDisplay String?
  pulledAt      DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  card    Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  showcaseItems ShowcaseItem[]

  @@index([userId, pulledAt])
  @@index([userId, cardId])
  @@index([productId])
  @@index([cardId])
}

model WishlistItem {
  userId  String
  cardId  String
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
}

model Favorite {
  userId  String
  cardId  String
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
}

model Binder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages BinderPage[]

  @@index([userId])
}

model BinderPage {
  id       String @id @default(cuid())
  binderId String
  pageNumber Int
  label    String?

  binder Binder             @relation(fields: [binderId], references: [id], onDelete: Cascade)
  slots  BinderSlot[]

  @@unique([binderId, pageNumber])
}

model BinderSlot {
  id           String @id @default(cuid())
  binderPageId String
  position     Int
  userCardId   String?

  page BinderPage @relation(fields: [binderPageId], references: [id], onDelete: Cascade)

  @@unique([binderPageId, position])
}

model ShowcaseItem {
  id         String @id @default(cuid())
  userId     String
  userCardId String
  position   Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userCard UserCard @relation(fields: [userCardId], references: [id], onDelete: Cascade)

  @@unique([userId, position])
  @@unique([userId, userCardId])
  @@index([userId])
}
